# Obsidian Workspace and Cache
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.trash/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python / PyTorch temporary files
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Large model weights (keep vault lightweight)
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.h5

# Local scratch
scratch/

# Local PDF extraction utility; install separately on each computer
.obsidian/plugins/obsidian-zotero-desktop-connector/pdfannots2json*.exe

# Zotero installers and databases are not vault content
*.xpi
zotero.sqlite*
better-bibtex.sqlite*

# Local maintenance artifacts
.maintenance/
