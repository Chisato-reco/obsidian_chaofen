{
  "database": "Zotero",
  "noteImportFolder": "10_Literature",
  "openNoteAfterImport": true,
  "whichNotesToOpenAfterImport": "first-imported-note",
  "pdfExportImageDPI": 150,
  "pdfExportImageFormat": "png",
  "pdfExportImageQuality": 90,
  "citeFormats": [
    {
      "name": "Insert Markdown Citation",
      "format": "template",
      "template": "[@{{citekey}}]"
    },
    {
      "name": "Insert Zotero Link",
      "format": "template",
      "template": "[{{title}}]({{desktopURI}})"
    }
  ],
  "exportFormats": [
    {
      "name": "Create Literature Note",
      "outputPathTemplate": "10_Literature/{{citekey}}.md",
      "templatePath": "90_Templates/Template - Zotero Literature Note.md",
      "imageOutputPathTemplate": "99_Attachments/{{citekey}}/",
      "imageBaseNameTemplate": "image",
      "cslStyle": ""
    }
  ],
  "citeSuggestTemplate": "[[{{citekey}}]]",
  "shouldConcat": false
}
